# The hash-locked requirements and the shell scripts are used on Linux (CI, the
# build container). Git for Windows with autocrlf would otherwise check them out
# with CRLF, which breaks the scripts and makes the compile drift check noisy.
*.sh text eol=lf
*.bats text eol=lf
deployment/vm/reconciler/test/stubs/* text eol=lf
serve_api/requirements*.txt text eol=lf
# Read by scripts/read-release.sh in CI and by scripts/write-sbom.py; both reject a CR.
serve_api/RELEASE text eol=lf
# Its FROM line is read by sed in /bump-release (.claude/commands/bump-release.md).
serve_api/Dockerfile text eol=lf
deployment/vm/cloud-init.yaml text eol=lf
deployment/vm/reconciler/*.service text eol=lf
deployment/vm/reconciler/*.timer text eol=lf
.github/rulesets/*.json text eol=lf
deployment/vm/stable/Caddyfile text eol=lf
deployment/vm/stable/compose.yml text eol=lf
scripts/*.py text eol=lf
scripts/test/*.py text eol=lf
docs/sbom/*.json text eol=lf
