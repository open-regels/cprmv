VERSION "1.2"
BASE :<http://example.com/>
PREFIX cpsv: <http://purl.org/vocab/cpsv#>
PREFIX cprmv: <https://cprmv.open-regels.nl/0.3.0/>
PREFIX cprmvmethods: <https://cprmv.open-regels.nl/0.3.0/methods/>
PREFIX overheid: <http://standaarden.overheid.nl/owms/terms/>
<http://opencatalogi.open-regels.nl/De_Heusdenpas.dmn.0.1> a cprmv:RuleSet;
    cprmv:extends <http://opencatalogi.open-regels.nl/jci1.3?BWBR0002221&z=2025-01-01&g=2025-01-01>;
    cprmv:extends <http://opencatalogi.open-regels.nl/...>;
    cprmv:id "De_Heusdenpas.dmn-0.1";
    cprmv:method cprmvmethods:dmn13;
    cprmv:output-of [
        a cpsv:PublicService;
        cprmv:id <https://identifier.overheid.nl/tooi/id/upl/gmb/De_Heusdenpas>
        cprmv:providedBy [ overheid:authority "Gemeente Heusden" ];
        cpsv:produces <http://opencatalogi.open-regels.nl/De_Heusdenpas.dmn.0.1>
    ]
    cprmv:contains ([
        a cprmv:Rule;
        cprmv:id "DMN, BWBR0002221, Hoofdstuk III, § 1, Artikel 7a, lid 1";
        cprmv:extends <http://opencatalogi.open-regels.nl/jci1.3?BWBR0002221&hoofdstuk=I&artikel=7a&lid=1&z=2025-01-01&g=2025-01-01>;
        cprmv:sourcequote "De pensioengerechtigde leeftijd en de aanvangsleeftijd zijn:"@nl;
        cprmv:comment "Deze regel betreft enkel de definitie van de pensioengerechtigde leeftijd, niet de aanvangsleeftijd..."@nl
        cprmv:definition """
  <decision id="leeftijdAOQMaanden" name="AOW leeftijd">
    <decisionTable id="DecisionTable_0u22kfy">
      <input id="InputClause_0zrs9gs" label="jaar van berekening">
        <inputExpression id="LiteralExpression_0y2ygh1" typeRef="number">
          <text>date(dagVanAanvraag).year</text>
        </inputExpression>
      </input>
      <output id="OutputClause_1p2dyb8" label="leeftijd AOW in maanden" name="leeftijdAOWMaanden" typeRef="number" />
      """;
        cprmv:contains [
            a cprmv:Rule;
            cprmv:id "DMN, BWBR0002221, Hoofdstuk III, § 1, Artikel 7a, lid 1, onderdeel i"
            cprmv:extends <http://opencatalogi.open-regels.nl/jci1.3?BWBR0002221&hoofdstuk=I&artikel=7a&o=i&lid=1&z=2025-01-01&g=2025-01-01>
            cprmv:sourcequote "in 2020: 66 jaar en vier maanden, ...";
            cprmv:comment "Deze regel betreft enkel de definitie van de pensioengerechtigde leeftijd, niet de aanvangsleeftijd..."@nl;
            cprmv:definition """
      <rule id="DecisionRule_0mzqrta">
        <inputEntry id="UnaryTests_18ke7fz">
          <text>2020</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0ejqiyh">
          <text>66 * 12 + 4</text>
        </outputEntry>
      </rule>"""
        ];
        cprmv:postdefinition """
            </decisionTable>
  </decision>
        """
      ...
      
    ].
    
      
     
