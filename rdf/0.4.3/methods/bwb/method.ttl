@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .

cprmvmethods:bwb a cprmvmethods:module;
    a cprmv:AnalysisMethod;
    a cprmv-serve:core-xml;
    cprmv:id "bwb"@nl;
    cprmv:label "BWB (NL)";
    cprmv:comment "zie: https://www.overheid.nl/sites/default/files/wetten/Procedurehandboek_BWB_3.7.pdf and https://www.overheid.nl/sites/default/files/pdf/Handleiding%2BSRU%2BBWB.pdf"@nl;
    cprmv-serve:xslt "bwb2cprmv.xsl";
    cprmvmethods:hasMethods (
        cprmvmethods:bwb
    ).
