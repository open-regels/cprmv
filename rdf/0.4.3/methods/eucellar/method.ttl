@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .

cprmvmethods:eucellar-fmx4 a cprmvmethods:module;
    a cprmv-serve:core-web;
    a cprmvmethods:fmx4;
    cprmv:id "eucellar-fmx4"@en;
    cprmv:id "eucellar-fmx4"@nl;
    cprmv:label "Formex v4 from EU CELLAR";
    cprmv:comment "see: ... "@en;
    cprmv-serve:publication-id-format "CFMX4{rulesetid}_{docid}";
    cprmv-serve:normalized-id-format "CFMX4{rulesetid}_{docid}";
    cprmv-serve:repository-publication-location-format "https://publications.europa.eu/resource/cellar/{rulesetid}/{docid}";
    cprmvmethods:hasMethods (
        cprmvmethods:eucellar-fmx4
    ).
