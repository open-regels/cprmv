@base <http://example.com/> .
@prefix schema: <http://schema.org/> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.0#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://standaarden.open-regels.nl/standards/cprmv/0.4.0#> a owl:Ontology;
  vann:preferredNamespaceURI "https://standaarden.open-regels.nl/standards/cprmv/0.4.0#";
  vann:preferredNamespacePrefix "cprmv";
  dct:title "CPRMV";
  dct:description "Core Public Rule Management Vocabulary is a vocabulary for expressing knowledge about agreements published as rules which can both be expressed in natural language like articles in laws as well as more formal business rules for automation of decisions, and also how all these rules relate to each other as well as to the concepts in the Core Public Service Vocabulary. It is based on the notion that all these rules are also produced as the ouput of a service delivered by Public Organizations. Typically many rules are used in the context of other services, and to some extend this requires organizations to collaborate on them, even during operationalized in services that follow them. CPRMV allows for the possibility to make all this more transparent and structured. It extends the other Core Vocabularies in this regard.";
  owl:versionIRI <https://standaarden.open-regels.nl/standards/cprmv/0.4.0#>;
  owl:versionInfo "0.4.0";
  dct:created "2026-02-08"^^xsd:date;
  dct:creator <https://www.ictu.nl/>;
  dct:license <https://creativecommons.org/licenses/by/4.0/>;
  rdfs:seeAlso <https://www.open-regels.nl/standards/cprmv> .

cprmv:RuleSet a owl:Class;
    skos:prefLabel "Rule Set"@en;
    skos:definition "A set of Rule's. Which is produced as cv:Ouput within a cpsv:Publicservice while also always becoming a eli:LegalResource implemented by a cpsv:Rule followed by cpsv:Publicservice. Note however that with CPRMV, the resources a cpsv:Rule represent possibly are cprmv:RuleSet's themselves. Also, being a cv:Ouput, a cprmv:RuleSet cprmv:is_part_of a dcat.Dataset "@en;
    rdfs:subClassOf eli:LegalResource;
    rdfs:subClassOf cv:Output.

cprmv:id a owl:ObjectProperty;
    skos:prefLabel "id"@en;
    skos:definition "denotes a universal unique id with which to refer to what the cprmv object like RuleMethod's Explanation's, RuleSet's and Rule's represents."@en;
    rdfs:domain (owl:unionOf (cprmv:Rule cprmv:RuleSet cprmv:RuleMethod)).
    
cprmv:extends a owl:ObjectProperty;
    skos:prefLabel "extends"@en;
    skos:definition "In the case of a RuleSet this property states the RuleSet to be eli:based_on an eli:LegalResource (which includes any cprmv:RuleSet) the RuleSet extends in its entirety (all cprmv:Rules contained in the cprmv:RuleSet that is extended, depending on whether they are defined with the same cprmv:method or not, can or must have matching ones in the cprmv:RuleSet that extends) possibly aggregated by analysis or formalisation (not codification). In the case of a cprmv:Rule it refers to the matching cprmv:Rule contained in a cprmv:RuleSet that is extended by the RuleSet that contains the extending cprmv:Rule (this must be the case). A cprmv:Rule in the cprmv:RuleSet that is extended does not have to be referred by a cprmv:Rule contained in the extending cprmv:RuleSet if both RuleSet's contain only cprmv:Rule's defined with the same cprmv:method, in which case this implies the cprmv:Rule implicitly becomes part of the extending cprmv:RuleSet as is. Multiple cprmv:Rule's / cprmv:RuleSet's can be extended within the same cprmv:Rule / cprmv:RuleSet"@en;
    rdfs:isSubPropertyOf eli:based_on;
    rdfs:domain (owl:unionOf (cprmv:Rule cprmv:RuleSet));
    rdfs:range (owl:unionOf (cprmv:Rule cprmv:RuleSet)).

cprmv:is_output_of a owl:ObjectProperty;
    skos:prefLabel "output of"@en;
    skos:definition "denotes a cprmv:RuleSet to be produced as cv:Ouput of a cpsv:PublicService"@en;
    rdfs:isSubPropertyOf [ owl:inverseOf schema:serviceOutput ];
    rdfs:isSubPropertyOf prov:wasGeneratedBy;
    rdfs:domain cprmv:RuleSet;
    rdfs:range cpsv:PublicService.

cprmv:method a owl:Class;
    skos:prefLabel "method"@en;
    skos:definition "denotes the cprmv:RuleMethod used to define the cprmv:RuleSet"@en;
    rdfs:domain cprmv:RuleSet;
    rdfs:range cprmv:RuleMethod.
  
cprmv:contains a owl:ObjectProperty;
    skos:prefLabel "contains"@en;
    skos:definition "denotes the ordered list of Rule's a Rule(Set) can contain and together with the cprmv:definition and cprmv:postDefinition properties (in case of Rule's') define the Rule(Set) by concatenating the definition, the definitions of the cprmv:Rule's it contains (in order) and the postDefinition"@en;
    rdfs:domain (owl:unionOf (cprmv:Rule cprmv:RuleSet));
    rdfs:range (owl:unionOf (cprmv:Rule cprmv:RuleSet)).
    
cprmv:definition a owl:ObjectProperty;
    skos:prefLabel "definition"@en;
    skos:definition "denotes the head part of the definition of a cprmv:Rule which is either a rdfs:text or any representation of knowledge in the form of rdf"@en;
    rdfs:range rdfs:Resource.

cprmv:postDefinition a owl:ObjectProperty;
    skos:prefLabel "postDefinition"@en;
    skos:definition "denotes the tail part of the definition of a cprmv:Rule which is either a rdfs:text or any representation of knowledge in the form of rdf. This property is only to be used when there are one or more cprmv:Rule's contained by the cprmv:Rule this property belongs to"@en;
    rdfs:domain cprmv:Rule;
    rdfs:range rdfs:Resource.
       
cprmv:comment a owl:ObjectProperty;
    skos:prefLabel "comment"@en;
    skos:definition "denotes information as comment for a cprmv:Rule, cprmv:RuleSet or cprmv:RuleMethod"@en;
    rdfs:domain (owl:unionOf (cprmv:Rule cprmv:RuleSet cprmv:RuleMethod));
    rdfs:range rdfs:Resource.

cprmv:sourcequote a owl:ObjectProperty;
    skos:prefLabel "source quote"@en;
    skos:definition "replicates (a part of) the definition of the cprmv:Rule that is being extended"@en;
    rdfs:domain cprmv:Rule;
    rdfs:range rdfs:Resource.
    
cprmv:Rule a owl:Class;
    skos:prefLabel "Rule"@en;
    skos:definition "A Rule denotes a official expression of an agreement which can both be expressed in natural language like articles in laws as well as more formal business rules for automation of decisions"@en.

cprmv:RuleMethod a owl:Class;
    skos:prefLabel "Rule Method"@en;
    skos:definition "A Rule Method is a acknowledged known method for defining Rule's, either from scratch through deliberation and / or based on existing Rule's."@en.

cprmv:AnalysisMethod a owl:Class;
    skos:prefLabel "Analysis Method"@en;
    skos:definition "A Rule Method with which an existing Rule is extended through analysis, which does not yet entirely formalises a Rule semantically but only defines what is to be seen as a separate Rule and adds metadata to it or normalises its form etcetera."@en;
    rdfs:subClassOf cprmv:RuleMethod.

cprmv:FormalisationMethod a owl:Class;
    skos:prefLabel "Formalisation Method"@en;
    skos:definition "A Rule Method with which an existing Rule is extended through formalisation, which entirely formalises a Rule semantically as far as possible and makes it represented in a interoperable way to the point cprmv compatible systems can comsume them within processes for delivering Public Services."@en;
    rdfs:subClassOf cprmv:RuleMethod.

cprmv:CodificationMethod a owl:Class;
    skos:prefLabel "Codification Method"@en;
    skos:definition "A Rule Method with which an existing Rule is extended through codification, which entirely formalises a Rule semantically if necesary as well as codifies them into an executable form that can be utilised by specific systems within processes for delivering Public Services."@en;
    rdfs:subClassOf cprmv:RuleMethod.

cprmv:ExecutionMethod a owl:Class;
    skos:prefLabel "Execution Method"@en;
    skos:definition "A Rule Method with which an existing Rule is executed in the context of delivering a Public Service."@en;
    rdfs:subClassOf cprmv:RuleMethod.

cprmv:ExplanationMethod a owl:Class;
    skos:prefLabel "ExplanationMethod"@en;
    skos:definition "An explanation method defines the method for producing Explanations in relation to cprmv:Rule(Set)'s'"@en;
    rdfs:subClassOf cprmv:RuleMethod.

cprmv:TestMethod a owl:Class;
    skos:prefLabel "TestMethod"@en;
    skos:definition "A Rule Method with which Rule's are defined that describe test scenario's defined in cprmv:TestSet's containing cprmv:TestCase's, which are specialised cprmv:RuleSet's and cprmv:Rule's and that can be tested in the context of a cprmv:RuleSet's."@en;
    rdfs:subClassOf cprmv:RuleMethod.

cprmv:AnalysisMethod a owl:Class;
    skos:prefLabel "Analysis Method"@en;
    skos:definition "A Rule Method with which an existing Rule is extended through analysis, which does not yet entirely formalises a Rule semantically but only defines what is to be seen as a separate Rule and adds metadata to it or normalises its form etcetera."@en;
    rdfs:subClassOf cprmv:RuleMethod.

cprmv:PublicationMethod a owl:Class;
    skos:prefLabel "PublicationMethod"@en;
    skos:definition "A Rule Method for publication of the definition of Rule(Set)'s apart from the Execution of them..."@en;
    rdfs:subClassOf cprmv:RuleMethod.

cprmv:ReferencenMethod a owl:Class;
    skos:prefLabel "ReferenceMethod"@en;
    skos:definition "A Rule Method for the referencing of Rule(Set)'s apart from the Execution of them..."@en;
    rdfs:subClassOf cprmv:RuleMethod.

cprmv:Explanation a owl:Class;
    skos:prefLabel "TestCase"@en;
    skos:definition "A cprmv:Explanation is a cprmv:Rule defined with a cprmv:ExplanationMethod. Thile Rule contains a concise explanation of one or multiple Rule's or RuleSet's."@en;
    rdfs:subClassOf cprmv:Rule.

cprmv:TestCase a owl:Class;
    skos:prefLabel "TestCase"@en;
    skos:definition "A TestCase is a cprmv:Case defined for and following a TestMethod"@en;
    rdfs:subClassOf cprmv:Case.
    
cprmv:TestSet a owl:Class;
    skos:prefLabel "TestSet"@en;
    skos:definition "A TestSet is a cprmv:RuleSet containing cprmv:TestCase's defined for following a TestMethod"@en;
    rdfs:subClassOf cprmv:RuleSet.
    
cprmv:Decision a owl:Class;
    skos:prefLabel "Decision"@en;
    skos:definition "A Decision is a cprmv:Rule defined following a ExecutionMethod"@en;
    rdfs:subClassOf cprmv:Rule.
    
cprmv:Case a owl:Class;
    skos:prefLabel "Case"@en;
    skos:definition "A Case is a cprmv:Rule containing a list of Decisions defined following a ExecutionMethod"@en;
    rdfs:subClassOf cprmv:Rule.

cprmv:explains a owl:ObjectProperty;
    skos:prefLabel "explains"@en;
    skos:definition "denotes the cprmv:Rule(Set) a cprmv:Eplanation holds explanatory content of for the use of explaining them in the systems that use them for delivering Public Services"@en;
    rdfs:domain cprmv:Explanation
    rdfs:range (owl:unionOf (cprmv:Rule cprmv:RuleSet));
