@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .

cprmv:RuleSetShape
    a sh:NodeShape ;
    sh:targetClass cprmv:RuleSet ;
    sh:property [
        sh:path cprmv:id ;
        sh:minCount 1 ;
        sh:or (
           [ sh:datatype xsd:string ]
           [ sh:datatype rdf:langString ]
        ) ;
    ] ;
    sh:property [
        sh:path cprmv:comment ;
        sh:minCount 0 ;
        sh:or (
           [ sh:datatype xsd:string ]
           [ sh:datatype rdf:langString ]
        ) ;
    ] ;
    sh:property [
        sh:path cprmv:validFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cprmv:validUntil ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cprmv:publishedOn ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path cprmv:isBasedOn ;
        sh:class cprmv:RuleSet ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path cprmv:isOutputOf ;
        sh:class cpsv:PublicService ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path cprmv:hasMethod ;
        sh:class cprmv:RuleMethod ;
        sh:minCount 1 ;
    ]  ;
    sh:property cprmv:hasPartShape .

cprmv:DecisionModelShape
    a sh:NodeShape ;
    sh:targetClass cprmv:DecisionModel ;
    sh:property [
        sh:path cprmv:hasAnalysis ;
        sh:class cprmv:Analysis ;
        sh:minCount 0 ;
    ] .

cprmv:RuleShape
    a sh:NodeShape ;
    sh:targetClass cprmv:Rule ;
    sh:property [
        sh:path cprmv:id ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path cprmv:definition ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cprmv:postDefinition ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cprmv:sourcequote ;
        sh:minCount 0 ;
        sh:or (
           [ sh:datatype xsd:string ]
           [ sh:datatype rdf:langString ]
        ) ;
    ] ;
    sh:property [
        sh:path cprmv:comment ;
        sh:minCount 0 ;
        sh:or (
           [ sh:datatype xsd:string ]
           [ sh:datatype rdf:langString ]
        ) ;
    ] ;
    sh:property [
        sh:path cprmv:isBasedOn ;
        sh:class cprmv:Rule ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path cprmv:hasPart ;
        sh:minCount 0 ;
    ] .

cprmv:RuleMethodShape
    a sh:NodeShape ;
    sh:targetClass cprmv:RuleMethod ;
    sh:property [
        sh:path cprmv:id ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path cprmv:comment ;
        sh:minCount 0 ;
        sh:or (
           [ sh:datatype xsd:string ]
           [ sh:datatype rdf:langString ]
        ) ;
    ] ;
    sh:property [
        sh:path cprmv:refinesTowards ;
        sh:minCount 0 ;
        sh:class cprmv:Echelon ;
    ] ;
    sh:property [
        sh:path cprmv:refinesFrom ;
        sh:minCount 0 ;
        sh:class cprmv:Echelon ;
    ] .

cprmv:AnalysisMethodShape
    a sh:NodeShape ;
    sh:targetClass cprmv:AnalysisMethod ;
    sh:property [
        sh:path cprmv:refinesTowards ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class cprmv:AgreementEchelon ]
            [ sh:class cprmv:SemanticEchelon ]
            [ sh:class cprmv:OntologicEchelon ]
        ) ;
    ] ;
    sh:property [
        sh:path cprmv:refinesFrom ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class cprmv:AgreementEchelon ]
            [ sh:class cprmv:SemanticEchelon ]
            [ sh:class cprmv:OntologicEchelon ]
        ) ;
    ] .

cprmv:FormalisationMethodShape
    a sh:NodeShape ;
    sh:targetClass cprmv:FormalisationMethod ;
    sh:property [
        sh:path cprmv:refinesTowards ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class cprmv:LogicEchelon ]
            [ sh:class cprmv:OperableEchelon ]
        ) ;
    ] ;
    sh:property [
        sh:path cprmv:refinesFrom ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class cprmv:AgreementEchelon ]
            [ sh:class cprmv:SemanticEchelon ]
            [ sh:class cprmv:OntologicEchelon ]
            [ sh:class cprmv:LogicEchelon ]
        ) ;
    ] .

cprmv:CodificationMethodShape
    a sh:NodeShape ;
    sh:targetClass cprmv:CodificationMethod ;
    sh:property [
        sh:path cprmv:refinesTowards ;
        sh:minCount 0 ;
        sh:class cprmv:OperableEchelon ;
    ] ;
    sh:property [
        sh:path cprmv:refinesFrom ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class cprmv:AgreementEchelon ]
            [ sh:class cprmv:SemanticEchelon ]
            [ sh:class cprmv:OntologicEchelon ]
            [ sh:class cprmv:LogicEchelon ]
        ) ;
    ] .

cprmv:ExecutionMethodShape
    a sh:NodeShape ;
    sh:targetClass cprmv:ExecutionMethod ;
    sh:property [
        sh:path cprmv:refinesTowards ;
        sh:minCount 0 ;
        sh:class cprmv:OperableEchelon ;
    ] ;
    sh:property [
        sh:path cprmv:refinesFrom ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class cprmv:AgreementEchelon ]
            [ sh:class cprmv:LogicEchelon ]
            [ sh:class cprmv:OperableEchelon ]
        ) ;
    ] .

cprmv:ExplanationMethodShape
    a sh:NodeShape ;
    sh:targetClass cprmv:ExplanationMethod ;
    sh:property [
        sh:path cprmv:refinesTowards ;
        sh:minCount 0 ;
        sh:class cprmv:OperableEchelon ;
    ] ;
    sh:property [
        sh:path cprmv:refinesFrom ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class cprmv:AgreementEchelon ]
            [ sh:class cprmv:SemanticEchelon ]
            [ sh:class cprmv:OntologicEchelon ]
            [ sh:class cprmv:LogicEchelon ]
            [ sh:class cprmv:OperableEchelon ]
        ) ;
    ] .

cprmv:TestMethodShape
    a sh:NodeShape ;
    sh:targetClass cprmv:TestMethod ;
    sh:property [
        sh:path cprmv:refinesTowards ;
        sh:minCount 0 ;
        sh:class cprmv:SupportEchelon ;
    ] ;
    sh:property [
        sh:path cprmv:refinesFrom ;
        sh:minCount 0 ;
        sh:class cprmv:OperableEchelon ;
    ] .

cprmv:PublicationMethodShape
    a sh:NodeShape ;
    sh:targetClass cprmv:PublicationMethod ;
    sh:property [
        sh:path cprmv:refinesTowards ;
        sh:minCount 0 ;
        sh:class cprmv:OperableEchelon ;
    ] ;
    sh:property [
        sh:path cprmv:refinesFrom ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class cprmv:AgreementEchelon ]
            [ sh:class cprmv:SemanticEchelon ]
            [ sh:class cprmv:OntologicEchelon ]
            [ sh:class cprmv:LogicEchelon ]
            [ sh:class cprmv:OperableEchelon ]
        ) ;
    ] .

cprmv:ReferenceMethodShape
    a sh:NodeShape ;
    sh:targetClass cprmv:ReferenceMethod .

cprmv:hasPartShape a sh:PropertyShape ;
  sh:path ( cprmv:hasPart [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
  sh:minCount 1 ;
  sh:class cprmv:Rule .

cprmv:ExplanationShape
    a sh:NodeShape ;
    sh:targetClass cprmv:Explanation ;
    sh:property [
        sh:path cprmv:explains ;
        sh:or (
            [ sh:class cprmv:Rule ]
            [ sh:class cprmv:RuleSet ]
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

cprmv:TestCaseShape
    a sh:NodeShape ;
    sh:targetClass cprmv:TestCase .

cprmv:TestSetShape
    a sh:NodeShape ;
    sh:targetClass cprmv:TestSet.

cprmv:DecisionShape
    a sh:NodeShape ;
    sh:targetClass cprmv:Decision .

cprmv:CaseShape
    a sh:NodeShape ;
    sh:targetClass cprmv:Case .

cprmv:EchelonShape
    a sh:NodeShape ;
    sh:targetClass cprmv:Echelon .
