@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:regelrecht a cprmvmethods:git;
    a cprmv:FormalisationMethod;
    a cprmv:ExecutionMethod;
    cprmv:id "RegelRecht git repository"@nl;
    cprmv:label "corpus of RegelRecht Git Repository";
    cprmv:comment "zie https://regelrecht.rijks.app";
    cprmv-serve:publication-id-format "RR_{rulesetid}_{date}_{index}";
    cprmv-serve:normalized-id-format "RR_{rulesetid}_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://github.com/MinBZK/regelrecht/tree/main/corpus".
