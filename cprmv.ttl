VERSION "1.2"
BASE :<http://example.com/>
PREFIX cpsv: <http://purl.org/vocab/cpsv#>
PREFIX cprmv: <https://cprmv.open-regels.nl/0.2.0/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX cv: <http://data.europa.eu/m8g/>

<https://www.open-regels.nl/standards/cprmv/0.3.0> a owl:Ontology;
  vann:preferredNamespaceURI "https://www.open-regels.nl/standards/cprmv/";
  vann:preferredNamespacePrefix "cprmv";
  dct:title "CPRMV";
  dct:description "Core Public Rule Management Vocabulary is a vocabulary for expressing knowledge about agreements published as rules which can both be expressed in natural language like articles in laws as well as more formal business rules for automation of decisions, and also how all these rules relate";
  owl:versionIRI <https://www.open-regels.nl/standards/cprmv/0.3.0>;
  owl:versionInfo "0.3.0";
  dct:created "2025-06-25"^^xsd:date;
  dct:creator <https://www.ictu.nl/>;
  dct:license <https://creativecommons.org/licenses/by/4.0/>;
  rdfs:seeAlso <https://www.open-regels.nl/standards/cprmv> .

cprmv:RuleSet a owl:Class;
    rdfs:label "Rule Set"@en;
    rdfs:comment "A set of Rule's"@en;
    a eli:LegalResource;
    a cv:output;
    a cpsv:Rule.

cprmv:id a owl:ObjectProperty;
    rdfs:label "id"@en
    rdfs:comment "denotes a universal unique id with which to refer to what the cprmv object like RuleMethod's Explanation's, RuleSet's and Rule's represents."@en.
    
cprmv:extends a owl:ObjectProperty;
    rdfs:label "extends"@en
    rdfs:comment "In the case of a RuleSet this property refers to an eli:LegalResource (which includes any cprmv:RuleSet) the RuleSet extends in its entirety (all cprmv:Rules contained in the cprmv:RuleSet that is extended, depending on whether they are defined with the same cprmv:method or not, can or must have matching ones in the cprmv:RuleSet that extends) by analysis or formalisation (not codification). In the case of a cprmv:Rule it refers to the matching cprmv:Rule contained in a cprmv:RuleSet that is extended by the RuleSet that contains the extending cprmv:Rule (this must be the case). A cprmv:Rule in the cprmv:RuleSet that is extended does not have to be referred by a cprmv:Rule contained in the extending cprmv:RuleSet if both RuleSet's are defined with the same cprmv:method, in which case this implies the cprmv:Rule implicitly becomes part of the extending cprmv:RuleSet as is. Multiple cprmv:Rule's / cprmv:RuleSet's can be extended within the same cprmv:Rule / cprmv:RuleSet"@en.

cprmv:output-of a owl:ObjectProperty;
    rdfs:label "output of"@en
    rdfs:comment "denotes the cpsv:PublicService a cprmv:RuleSet is the cv:output of"@en.

cprmv:method a owl:ObjectProperty;
    rdfs:label "method"@en;
    rdfs:comment "denotes the cprmv:RuleMethod used to define the cprmv:RuleSet"@en.
    
cprmv:contains a owl:ObjectProperty;
    rdfs:label "contains"@en;
    rdfs:comment "denotes the ordered list of Rule's a Rule(Set) can contain and together with the cprmv:definition and cprmv:postDefinition properties (in case of Rule's') define the Rule(Set) by concatenating the definition, the definitions of the cprmv:Rule's it contains (in order) and the postDefinition"@en.
    
cprmv:definition a owl:ObjectProperty;
    rdfs:label "definition"@en;
    rdfs:comment "denotes the head part of the definition of a cprmv:Rule which is either a rdfs:text or any representation of knowledge in the form of rdf"@en.
    
cprmv:postDefinition a owl:ObjectProperty;
    rdfs:label "postDefinition"@en;
    rdfs:comment "denotes the tail part of the definition of a cprmv:Rule which is either a rdfs:text or any representation of knowledge in the form of rdf. This property is only to be used when there are one or more cprmv:Rule's contained by the cprmv:Rule this property belongs to"@en.
    
cprmv:comment a owl:ObjectProperty;
    rdfs:label "comment"@en;
    a rdfs:comment.

cprmv:sourcequote a owl:ObjectProperty;
    rdfs:label "source quote"@en;
    rdfs:comment "replicates (a part of) the definition of the cprmv:Rule that is being extended"@en;
    a rdfs:text.
    
cprmv:Rule a owl:Class;
    rdfs:label "Rule"@en;
    rdfs:comment "A Rule denotes a official expression of an agreement which can both be expressed in natural language like articles in laws as well as more formal business rules for automation of decisions"@en.
    
cprmv:RuleMethod a owl:Class;
    rdfs:label "Rule Method"@en;
    rdfs:comment "A Rule Method is a acknowledged known method for defining Rule's, either from scratch through deliberation and / or based on existing Rule's."@en.

cprmv:AnalysisMethod a owl:Class;
    rdfs:label "Analysis Method"@en;
    rdfs:comment "A Rule Method with which an existing Rule is extended through analysis, which does not yet entirely formalises a Rule semantically but only defines what is to be seen as a separate Rule and adds metadata to it or normalises its form etcetera."@en;
    a cprmv:RuleMethod.

cprmv:FormalisationMethod a owl:Class;
    rdfs:label "Formalisation Method"@en;
    rdfs:comment "A Rule Method with which an existing Rule is extended through formalisation, which entirely formalises a Rule semantically as far as possible and makes it represented in a interoperable way to the point cprmv compatible systems can comsume them within processes for delivering Public Services."@en;
    a cprmv:RuleMethod.

cprmv:CodificationMethod a owl:Class;
    rdfs:label "Codification Method"@en;
    rdfs:comment "A Rule Method with which an existing Rule is extended through codification, which entirely formalises a Rule semantically if necesary as well as codifies them into an executable form that can be utilised by specific systems within processes for delivering Public Services."@en;
    a cprmv:RuleMethod.

cprmv:TestMethod a owl:Class;
    rdfs:label "Rule"@en;
    rdfs:comment "A Rule Method with which Rule's are defined that describe test scenario's defined in cprmv:TestSet's containing cprmv:TestCase's, which are specialised cprmv:RuleSet's and cprmv:Rule's and that can be tested in the context of a cprmv:RuleSet's."@en;
    a cprmv:RuleMethod.
    
cprmv:TestCase a owl:Class;
    rdfs:label "TestCase"@en;
    rdfs:comment "A TestCase is a cprmv:Rule defined with a TestMethod"@en;
    a cprmv:Rule.
    
cprmv:TestCase a owl:Class;
    rdfs:label "TestCase"@en;
    rdfs:comment "A TestSet is a cprmv:RuleSet defined with a TestMethod"@en;
    a cprmv:RuleSet.

cprmv:Explanation a owl:Class;
    rdfs:label "Explanation"@en;
    rdfs:comment "An explanation holds content for the use of explaining an cprmv:Rule(Set) in the systems that use them for delivering Public Services."@en.

cprmv:explains a owl:ObjectProperty;
    rdfs:label "explains"@en;
    rdfs:comment "denotes the cprmv:Rule(Set) a cprmv:Eplanation holds explanatory content of for the use of explaining them in the systems that use them for delivering Public Services"@en.
