@startuml
left to right direction

package "cpsv-ap v3.2.0 (relevant part)" as cpsv-ap {
    object "cpsv-ap:Rule" as cpsvrule
    object "cpsv-ap:PublicService" as service
    service "0..*" -u-> cpsvrule : follows
    
    object "eli:LegalResource" as legalresource
    legalresource <-[dotted]- "0..*" cpsvrule : implements
    object "cv:output" as output
    service "0..*" -l-> output : produces
    object "dcat:dataset" as dcat
    output --> "0..*" dcat : isPartOf
    object "cv:Event" as event
    object "cv.LifeEvent" as lifeevent
    lifeevent -u-|> event
    service <-- event : hasRelatedService
    service --> event : isGroupedBy

    object "cv:PublicOrganisation" as organisation
    service --> "1..*" organisation : hasCompetentAuthority

    service "0..*" --> service : requires
    service "0..*" --> service : related
}

package cprmv {
    object RuleSet {
        id
        comment
	validFrom
	validUntil
	publishedOn
    }
    object TestSet
    TestSet -u-|> RuleSet
    RuleSet --|> legalresource
    object DecisionModel
    DecisionModel --|> RuleSet
    object Analysis
    Analysis --|> RuleSet
    object Rule {
        id
        comment
        sourcequote
        definition
        postDefinition
    }
    object Parameter
    Parameter --|> Rule
    object TestCase
    object Case
    TestCase -u-|> Rule
    RuleSet *-- Rule : hasPart
    TestSet *-- TestCase : hasPart
    Rule "0..*" --> Rule : isBasedOn
    Case -u-|> RuleSet
    object Decision 
    Decision -u-|> Rule 
    Case *-- Decision : hasPart

    object Explanation {
        id
        type
        comment
    }

    RuleSet <-l- Explanation : explains
    Rule <-l- Explanation : explains

    object RuleMethod {
        id
        comment
    }
    Rule --> "1..1" RuleMethod : hasMethod
    RuleMethod <-l- Explanation : explains

    object AnalysisMethod
    object FormalisationMethod
    object TestMethod
    object ExecutionMethod
    object PublicationMethod
    object ReferenceMethod
    RuleMethod <|-- AnalysisMethod
    RuleMethod <|-- FormalisationMethod
    RuleMethod <|-- TestMethod
    RuleMethod <|-- ExecutionMethod
    RuleMethod <|-- PublicationMethod
    RuleMethod <|-- ReferenceMethod
    DecisionModel --> Analysis : hasAnalysis
    
    package cprmvmethods {
        object rulemethods
        RuleMethod <-- rulemethods : acknowledged
    }
    
    TestCase "1..1" --> TestMethod : hasMethod
    Decision "1..1" --> ExecutionMethod : hasMethod
    
}

RuleSet --> "1..1" legalresource : isBasedOn
RuleSet  -[dotted]-> service : "output-of"
output <|--  RuleSet

@enduml
