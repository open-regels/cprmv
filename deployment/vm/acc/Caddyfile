# Acceptance: the API behind Caddy. The status file is written by the
# reconciler into /opt/cprmv/acc/www, mounted read-only at /srv/status.

(app) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
	}

	handle /deploy-status.json {
		root * /srv/status
		header Cache-Control "no-store"
		file_server
	}

	handle {
		reverse_proxy cprmv-api:8000
	}
}

# Automatic HTTPS once DNS points here.
acc.cprmv.open-regels.nl {
	import app
}

# Plain HTTP on the VM's IP, for checking the deployment before DNS moves.
# Requests for any other host name are served too; no redirect to HTTPS.
:80 {
	import app
}
