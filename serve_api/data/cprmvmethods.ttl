@base <https://standaarden.open-regels.nl/standards/cprmv/0.4.2/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://standaarden.open-regels.nl/standards/cprmv/0.4.2/methods> a owl:Ontology;
  vann:preferredNamespaceURI "https://standaarden.open-regels.nl/standards/cprmv/0.4.2/methods";
  vann:preferredNamespacePrefix "cprmv";
  dct:title "CPRMV";
  dct:description "Core Public Rule Management Vocabulary is a vocabulary for expressing knowledge about agreements published as rules which can both be expressed in natural language like articles in laws as well as more formal business rules for automation of decisions, and also how all these rules relate";
  owl:versionIRI <https://standaarden.open-regels.nl/standards/cprmv/0.4.2/methods>;
  owl:versionInfo "0.4.2";
  dct:created "2026-04-20"^^xsd:date;
  dct:creator <https://www.ictu.nl/>;
  dct:license <https://creativecommons.org/licenses/by/4.0/>;
  rdfs:seeAlso <https://www.open-regels.nl/standards/cprmv/methods>;
  owl:imports
        cprmvmethods:alef-regelspraak,
        cprmvmethods:alef-test,
        cprmvmethods:alef-webservice,
        cprmvmethods:bwb,
        cprmvmethods:catala,
        cprmvmethods:core.json,
        cprmvmethods:core.markdown,
        cprmvmethods:core.python,
        cprmvmethods:core.web,
        cprmvmethods:core.xml,
        cprmvmethods:core.yaml,
        cprmvmethods:cprmvapi,
        cprmvmethods:cvdr,
        cprmvmethods:dmn13,
        cprmvmethods:eli,
        cprmvmethods:eucellar,
        cprmvmethods:flint,
        cprmvmethods:fmx4,
        cprmvmethods:frbr-sru,
        cprmvmethods:git,
        cprmvmethods:jas,
        cprmvmethods:jrm,
        cprmvmethods:juriconnect,
        cprmvmethods:legifrance,
        cprmvmethods:mcdc,
        cprmvmethods:mnm,
        cprmvmethods:nrml,
        cprmvmethods:open-regels.nl,
        cprmvmethods:openfisca,
        cprmvmethods:operaton,
        cprmvmethods:regalgo,
        cprmvmethods:regelrecht,
        cprmvmethods:repository.overheid.nl .

cprmv:acknowledged a owl:ObjectProperty;
    skos:prefLabel "id"@en;
    skos:definition "denotes that a given RuleMethod is acknowledged to be an official member of a certain RuleMethod set."@en.

cprmvmethods:rulemethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:jas
        cprmvmethods:flint
        cprmvmethods:bwb
        cprmvmethods:cvdr
        cprmvmethods:fmx4
        cprmvmethods:dmn13
        cprmvmethods:operaton
        cprmvmethods:repository-overheid-nl-bwb
        cprmvmethods:repository-overheid-nl-cvdr
        cprmvmethods:eucellar-fmx4
        cprmvmethods:operaton.open-regels.nl
        cprmvmethods:cprmvapi
        cprmvmethods:juriconnect
        cprmvmethods:elifmx4
        cprmvmethods:elinl
    ).

cprmvmethods:analysismethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:jas
        cprmvmethods:flint
        cprmvmethods:bwb
        cprmvmethods:cvdr
        cprmvmethods:fmx4
    ).

cprmvmethods:formalisationmethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:dmn13
    ).

cprmvmethods:serialisationmethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:bwb
        cprmvmethods:cvdr
        cprmvmethods:fmx4
        cprmvmethods:dmn13
    ).

cprmvmethods:codificationmethods a owl:Class;
    cprmv:acknowledged ().

cprmvmethods:testmethods a owl:Class;
    cprmv:acknowledged ().

cprmvmethods:executionmethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:operaton
    ).

cprmvmethods:publicationmethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:repository-overheid-nl-bwb
        cprmvmethods:repository-overheid-nl-cvdr
        cprmvmethods:eucellar-fmx4
        cprmvmethods:operaton.open-regels.nl
    ).

cprmvmethods:referencemethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:cprmvapi
        cprmvmethods:juriconnect
        cprmvmethods:elifmx4
        cprmvmethods:elinl
    ).
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .

cprmvmethods:regelspraak a cprmv:FormalisationMethod;
    cprmv:id "RegelSpraak"@en;
    cprmv:id "RegelSpraak"@fr;
    cprmv:id "RegelSpraak"@nl;
    cprmv:label "RegelSpraak";
    cprmv:comment "see https://regelspraak.nl".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:bwb a cprmv:AnalysisMethod;
    a cprmv-serve:core-xml;
    cprmv:id "bwb"@nl;
    cprmv:label "BWB (NL)";
    cprmv:comment "zie: https://www.overheid.nl/sites/default/files/wetten/Procedurehandboek_BWB_3.7.pdf and https://www.overheid.nl/sites/default/files/pdf/Handleiding%2BSRU%2BBWB.pdf"@nl;
    cprmv-serve:xslt "bwb2cprmv.xsl".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .

cprmvmethods:catala a cprmv:FormalisationMethod;
    cprmv:id "Catala"@en;
    cprmv:id "Catala"@fr;
    cprmv:id "Catala"@nl;
    cprmv:label "Catala";
    cprmv:comment "See https://catala-lang.org".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .

cprmv-serve:core-json a cprmv:SerialisationMethod;
    cprmv:id "core.json"@nl;
    cprmv:label "CPRMV API - Generic JSON Serialisation Method";
    cprmv:comment "CPRMV API - Generic JSON Serialisation  Method".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .

cprmv-serve:core-web a cprmv:PublicationMethod;
    cprmv:id "core.web"@nl;
    cprmv:label "CPRMV API - Generic Web Publication Method";
    cprmv:comment "CPRMV API - Generic Web Publication Method".

cprmv-serve:repository-publication-location-format a owl:ObjectProperty;
    skos:prefLabel "repository-publication-location-format"@en;
    skos:definition "The format of the URL to retrieve a publication"@en;
    rdfs:domain cprmv-serve:core-web.
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .

cprmv-serve:core-xml a cprmv:SerialisationMethod;
    cprmv:id "core.xml"@nl;
    cprmv:label "CPRMV API - Generic XML Serialisation Method";
    cprmv:comment "CPRMV API - Generic XML Serialisation  Method".

cprmv-serve:xslt a owl:ObjectProperty;
    skos:prefLabel "xslt"@en;
    skos:definition "The name of the XSLT file to apply to transform the raw XML publication into RDF for use within the CPRMV API"@en;
    rdfs:domain cprmv-serve:core-xml.
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .

cprmv-serve:core-yaml a cprmv:SerialisationMethod;
    cprmv:id "core.yaml"@nl;
    cprmv:label "CPRMV API - Generic YAML Serialisation Method";
    cprmv:comment "CPRMV API - Generic YAML Serialisation  Method".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:cprmvapi a cprmv:ReferenceMethod;
    cprmv:id "cprmvapi"@en;
    cprmv:id "cprmvapi"@nl;
    cprmv:comment "CPRMV API functions as a Reference resolver but to enable this harbours it's own way of referencing (rule id path). Also it allows for additional functionality on top of what methods like juriconnect and eli offer";
    cprmv-serve:reference-format "{baseuri}/rules/{path}".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:cvdr a cprmv:AnalysisMethod;
    a cprmv-serve:core-xml;
    cprmv:id "cvdr"@nl;
    cprmv:label "CVDR (NL)";
    cprmv:comment "zie: https://www.overheid.nl/sites/default/files/pdf/Handleiding%2BSRU%2BBWB.pdf"@nl;
    cprmv-serve:xslt "cvdr2cprmv.xsl".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:dmn13 a cprmv:FormalisationMethod;
    a cprmv-serve:core-xml;
    cprmv:id "dmn13"@en;
    cprmv:id "dmn13"@nl;
    cprmv:label "DMN 1.3 on operaton.open-regels.nl (experimental)";
    cprmv:comment "see https://www.omg.org/spec/DMN/1.3/About-DMN";
    cprmv-serve:xslt "dmn13operaton2cprmv.xsl".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:elifmx4 a cprmv:ReferenceMethod;
    cprmv:id "elifmx4"@en;
    cprmv:id "elifmx4 on EU CELLAR"@nl;
    cprmv:comment "ELI references to Formex 4 documents in EU CELLAR";
    cprmv-serve:reference-format "http://data.europa.eu/eli/{typedoc}/{year}/{naturalnumber}/{start-date}".

cprmvmethods:elinl a cprmv:ReferenceMethod;
    cprmv:id "elinl"@en;
    cprmv:id "elinl"@nl;
    cprmv:comment "Experimental ELI for BWB and CVDR (Dutch standards)";
    cprmv-serve:reference-format "https://wetten.overheid.nl/{path}".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:eucellar-fmx4 a cprmv-serve:core-web;
    a cprmvmethods:fmx4;
    cprmv:id "eucellar-fmx4"@en;
    cprmv:id "eucellar-fmx4"@nl;
    cprmv:label "Formex v4 from EU CELLAR";
    cprmv:comment "see: ... "@en;
    cprmv-serve:publication-id-format "CFMX4{rulesetid}_{docid}";
    cprmv-serve:normalized-id-format "CFMX4{rulesetid}_{docid}";
    cprmv-serve:repository-publication-location-format "https://publications.europa.eu/resource/cellar/{rulesetid}/{docid}".
