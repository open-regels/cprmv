cprmvmethods:flint a cprmv:AnalysisMethod;
    cprmv:id "Calculemus / FLINT"@en;
    cprmv:id "Calculemus / FLINT"@nl;
    cprmv:comment "zie: https://normativesystems.gitlab.io/knowledge-modeling/documentation-website/docs/"@nl;
    cprmv:comment "see: https://normativesystems.gitlab.io/knowledge-modeling/documentation-website/docs/"@en.
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:fmx4 a cprmv:AnalysisMethod;
    a cprmv-serve:core-xml;
    cprmv:id "fmx4"@en;
    cprmv:id "fmx4"@nl;
    cprmv:label "Formex v4 (EU)";
    cprmv:comment "see: ... "@en;
    cprmv-serve:xslt "fmx42cprmv.xsl".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .
@prefix frbr-sru: <https://cprmv.open-regels.nl/0.4.2/methods/frbr-sru/> .

cprmvmethods:frbr-sru a cprmv-serve:core-web;
    cprmv:id "FRBR SRU"@nl;
    cprmv:label "FRBR SRU";
    cprmv:comment "".

frbr-sru:url a owl:ObjectProperty;
    skos:prefLabel "url"@en;
    skos:definition "The URL the SRU REST service can be accessed."@en;
    rdfs:domain cprmvmethods:frbr-sru.

frbr-sru:response-publication-location-term-namespace a owl:ObjectProperty;
    skos:prefLabel "response-publication-location-term-namespace"@en;
    skos:definition "The namespace for the term in the SRU response that indicates the web location the publication can be retrieved from."@en;
    rdfs:domain cprmvmethods:frbr-sru.

frbr-sru:response-publication-location-term a owl:ObjectProperty;
    skos:prefLabel "response-publication-location-term"@en;
    skos:definition "The term name in the SRU response that indicates the web location the publication can be retrieved from."@en;
    rdfs:domain cprmvmethods:frbr-sru.

frbr-sru:response-from-date-term-namespace a owl:ObjectProperty;
    skos:prefLabel "response-from-date-term-namespace"@en;
    skos:definition "The namespace for the term in the SRU response that indicates the date from which the publication to be retrieved is valid."@en;
    rdfs:domain cprmvmethods:frbr-sru.

frbr-sru:response-from-date-term a owl:ObjectProperty;
    skos:prefLabel "response-from-date-term"@en;
    skos:definition "The term name in the SRU response that indicates the date from which the publication to be retrieved is valid."@en;
    rdfs:domain cprmvmethods:frbr-sru.
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:git a cprmv-serve:core-web;
    cprmv:id "Git"@nl;
    cprmv:label "Git";
    cprmv:comment "Public Git repository as ruleset publication repository".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .

cprmvmethods:jas a cprmv:AnalysisMethod;
    cprmv:id "Law Analysis / JAS"@en;
    cprmv:id "Wetsanalyse / JAS"@nl;
    cprmv:comment "zie: https://regels.overheid.nl/standaarden/wetsanalyse"@nl.
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:juriconnect a cprmv:ReferenceMethod;
    cprmv:id "juriconnect"@en;
    cprmv:id "juriconnect"@nl;
    cprmv:comment "Juriconnect (not fully supported yet)";
    cprmv-serve:reference-format 'jci1.{subversion}:c:BWB{bwbid}&{locatie-string}';
    cprmv-serve:reference-mapping (
        ( "aanwijzing" "Aanwijzing")
        ( "afdeling" "Afdeling")
        ( "artikel" "Artikel")
        ( "bijlage" "Bijlage")
        ( "boek" "Boek")
        ( "deel" "Deel")
        ( "enig" "enig")
        ( "hoofdstuk" "Hoofdstuk")
        ( "inhoudsopgave" "Inhoudsopgave")
        ( "nummer" "nummer")
        ( "paragraaf" "Paragraaf")
        ( "sub-paragraaf" "Paragraaf")
        ( "titeldeel" "Titeldeel")
        ( "taal" "taal")
        ( "verdragsonderdeel" "Verdragsonderdeel")
        ( "lid" "lid")
        ( "o" "onderdeel")
        ( "volzin" "volzin")
        ( "nummer" "nummer")
        ( cprmv-serve:reference-mapping-valid-on "g")
        ( cprmv-serve:reference-mapping-seen-on "z")
    ).
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .

cprmvmethods:nrml a cprmv:FormalisationMethod;
    a cprmv-serve:core-json;
    cprmv:id "NRML"@en;
    cprmv:id "NRML"@fr;
    cprmv:id "NRML"@nl;
    cprmv:label "NRML";
    cprmv:comment "Part of RegelRecht, see https://regelrecht.rijks.app".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.2#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.2/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.2/methods/> .

cprmvmethods:operaton.open-regels.nl a cprmvmethods:operaton;
    cprmv:id "operaton.open-regels.nl"@nl;
    cprmv:label "Operaton as repository at open-regels.nl IOU showcase environment";
    cprmv:comment "zie open-regels.nl"@nl;
    cprmv-serve:publication-id-format "DMN1.3_{deploymentid}R{resourceid}_{date}_{index}";
    cprmv-serve:normalized-id-format "DMN1.3_{rulesetid}_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://operaton.open-regels.nl/engine-rest/deployment/{deploymentid}/resources/{resourceid}/data".
