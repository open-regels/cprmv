cprmvmethods:openfisca a cprmv:FormalisationMethod;
    cprmv:id "OpenFisca"@en;
    cprmv:id "OpenFisca"@fr;
    cprmv:id "OpenFisca"@nl;
    cprmv:label "OpenFisca";
    cprmv:comment "see https://openfisca.org" .
@base <http://example.com/> .
