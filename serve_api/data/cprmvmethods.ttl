cprmv-serve:core-rdf a cprmv:core-web;
    cprmv:id "core.rdf"@nl;
    cprmv:label "CPRMV API - Generic RDF Publication Method";
    cprmv:comment "CPRMV API - Generic RDF Publication Method".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
