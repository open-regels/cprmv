@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cprmv-serve:core-web a cprmvmethods:module;
    a cprmv:PublicationMethod;
    cprmv:id "core.web"@nl;
    cprmv:label "CPRMV API - Generic Web Publication Method";
    cprmv:comment "CPRMV API - Generic Web Publication Method";
    cprmvmethods:hasMethods (
        cprmv-serve:core-web
    ).

cprmv-serve:repository-publication-location-format a owl:ObjectProperty;
    skos:prefLabel "repository-publication-location-format"@en;
    skos:definition "The format of the URL to retrieve a publication"@en;
    rdfs:domain cprmv-serve:core-web.
