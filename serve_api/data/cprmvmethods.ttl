@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cprmv-serve:core-xml a cprmvmethods:module;
    a cprmv:SerialisationMethod;
    cprmv:id "core.xml"@nl;
    cprmv:label "CPRMV API - Generic XML Serialisation Method";
    cprmv:comment "CPRMV API - Generic XML Serialisation  Method";
    cprmvmethods:hasMethods (
        cprmv-serve:core-xml
    ).

cprmv-serve:xslt a owl:ObjectProperty;
    skos:prefLabel "xslt"@en;
    skos:definition "The name of the XSLT file to apply to transform the raw XML publication into RDF for use within the CPRMV API"@en;
    rdfs:domain cprmv-serve:core-xml.
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .

cprmv-serve:core-yaml a cprmv:SerialisationMethod;
    cprmv:id "core.yaml"@nl;
    cprmv:label "CPRMV API - Generic YAML Serialisation Method";
    cprmv:comment "CPRMV API - Generic YAML Serialisation  Method".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .

cprmvmethods:cprmvapi a cprmv:ReferenceMethod;
    cprmv:id "cprmvapi"@en;
    cprmv:id "cprmvapi"@nl;
    cprmv:comment "CPRMV API functions as a Reference resolver but to enable this harbours it's own way of referencing (rule id path). Also it allows for additional functionality on top of what methods like juriconnect and eli offer";
    cprmv-serve:reference-format "{baseuri}/rules/{path}".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .

cprmvmethods:cvdr a cprmvmethods:module;
    a cprmv:AnalysisMethod;
    a cprmv-serve:core-xml;
    cprmv:id "cvdr"@nl;
    cprmv:label "CVDR (NL)";
    cprmv:comment "zie: https://www.overheid.nl/sites/default/files/pdf/Handleiding%2BSRU%2BBWB.pdf"@nl;
    cprmv-serve:xslt "cvdr2cprmv.xsl";
    cprmvmethods:hasMethods (
        cprmvmethods:cvdr
    ).
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .

cprmvmethods:dmn13 a cprmvmethods:module;
    a cprmv:FormalisationMethod;
    a cprmv-serve:core-xml;
    cprmv:id "dmn13"@en;
    cprmv:id "dmn13"@nl;
    cprmv:label "DMN 1.3 on operaton.open-regels.nl (experimental)";
    cprmv:comment "see https://www.omg.org/spec/DMN/1.3/About-DMN";
    cprmv-serve:xslt "dmn13operaton2cprmv.xsl";
    cprmvmethods:hasMethods (
        cprmvmethods:dmn13
    ).
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .
@prefix core-api: <https://cprmv.open-regels.nl/0.4.3/methods/core-api#> .

cprmvmethods:digitaal-stelsel-omgevingswet a cprmvmethods:module;
    cprmv:id "digitaal-stelsel-omgevingswet"@nl;
    cprmv:label "Digitaal Stelsel Omgevingswet";
    cprmvmethods:hasMethods (
        cprmvmethods:dso
        cprmvmethods:dso-service-register
    ).

cprmvmethods:dso a cprmv-serve:core-api;
    a cprmvmethods:sttr;
    cprmv:id "dso"@nl;
    cprmv:id "dso"@en;
    cprmv:label "DSO";
    cprmv:comment "see https://iplo.nl/digitaal-stelsel/";
    cprmv-serve:publication-id-format "DSO_{rulesetid}_{date}_{index}";
    cprmv-serve:normalized-id-format "DSO_{rulesetid}_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://service.omgevingswet.overheid.nl/publiek/toepasbare-regels/api/toepasbareregelsuitvoerengegevens/v1/toepasbareRegels/{rulesetid}/sttrBestand" ;
    cprmv-serve:utilizes cprmvmethods:dso-service-register;
    core-api:http-method "GET";
    core-api:api-headers (
        ("Accept" "application/xml")
        ("Content-Type" "application/xml")
        ("x-api-key" "pass_on_from_request")
    ).

cprmvmethods:dso-service-register a cprmv:ServiceRegister;
    a cprmv-serve:core-api;
    a cprmv-serve:core-json;
    cprmv:id "dso-service-register"@nl;
    cprmv:label "DSO as a service register";
    cprmv:comment "DSO functioneleStructuurRef can be seen as (sub)services. As service register, the rulesetid is tied to one specific functioneleStructuurRef as well as organisation responsible for the rules.";
    cprmv-serve:publication-id-format "DSOService_{rulesetid}_{date}_{index}";
    cprmv-serve:normalized-id-format "DSOService_{rulesetid}_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://service.omgevingswet.overheid.nl/publiek/toepasbare-regels/api/toepasbareregelsuitvoerengegevens/v1/toepasbareRegels/{rulesetid}";
    cprmv-serve:utilizes cprmvmethods:roo;
    core-api:http-method "GET";
    core-api:api-headers (
        ("Accept" "application/hal+json")
        ("Content-Type" "application/json")
        ("x-api-key" "pass_on_from_request")
    ).
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .

cprmvmethods:eli a cprmvmethods:module;
    cprmv:id "eli"@nl;
    cprmv:label "eli";
    cprmvmethods:hasMethods (
        cprmvmethods:elifmx4
        cprmvmethods:elinl
    ).

cprmvmethods:elifmx4 a cprmv:ReferenceMethod;
