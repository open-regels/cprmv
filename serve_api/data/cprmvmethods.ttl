cprmv-serve:core-sparql a cprmv-serve:core-web;
    cprmv:id "core.sparql"@nl;
    cprmv:label "CPRMV API - Generic SPARQL Publication Method";
    cprmv:comment "CPRMV API - Generic SPARQL Publication Method".

cprmv-serve:sparql-query a owl:ObjectProperty;
    skos:prefLabel "query"@en;
    skos:definition "The SPARQL query used to retrieve rulesets"@en;
    rdfs:domain cprmv-serve:core-sparql.
