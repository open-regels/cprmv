@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .
@prefix frbr-sru: <https://cprmv.open-regels.nl/0.4.3/methods/frbr-sru/> .

cprmvmethods:repository-overheid-nl a cprmvmethods:module;
    cprmv:id "repository.overheid.nl"@nl;
    cprmv:label "repository.overheid.nl";
    cprmvmethods:hasMethods (
        cprmvmethods:repository-overheid-nl-bwb
        cprmvmethods:repository-overheid-nl-cvdr
    ).

cprmvmethods:repository-overheid-nl-bwb a cprmvmethods:frbr-sru;
    a cprmvmethods:bwb;
    cprmv:id "repository.overheid.nl-bwb"@nl;
    cprmv:label "BWB publicaties op repository.overheid.nl (NL)";
    cprmv:comment "zie repository.overheid.nl"@nl;
    cprmv-serve:repository-publication-location-format "https://repository.officiele-overheidspublicaties.nl/bwb/BWB{rulesetid}/{date}_{index}/xml/BWB{rulesetid}_{date}_{index}.xml";
    cprmv-serve:publication-id-format "BWB{rulesetid}_{date}_{index}";
    cprmv-serve:normalized-id-format "BWB{rulesetid}_{date}_{index}";
    frbr-sru:url "https://zoekservice.overheid.nl/sru/Search?x-connection=BWB&operation=searchRetrieve&version=2.0&maximumRecords=1&query=dcterms.identifier=BWB{rulesetid}%20and%20overheidbwb.geldigheidsdatum={valid-on}";
    frbr-sru:response-publication-location-term-namespace
        "http://standaarden.overheid.nl/bwb/terms/";
    frbr-sru:response-publication-location-term
        "locatie_toestand";
    frbr-sru:response-from-date-term-namespace
        "http://standaarden.overheid.nl/bwb/terms/";
    frbr-sru:response-from-date-term
        "geldigheidsperiode_startdatum".

cprmvmethods:repository-overheid-nl-cvdr a cprmvmethods:frbr-sru;
    a cprmvmethods:cvdr;
    cprmv:id "repository.overheid.nl-cvdr"@nl;
    cprmv:label "CVDR publicaties op repository.overheid.nl (NL)";
    cprmv:comment "zie repository.overheid.nl"@nl;
    cprmv-serve:repository-publication-location-format "https://repository.officiele-overheidspublicaties.nl/cvdr/CVD{rulesetid}/{index}/xml/CVD{rulesetid}_{index}.xml";
    cprmv-serve:publication-id-format "CVD{rulesetid}_{index}";
    cprmv-serve:normalized-id-format "CVD{rulesetid}_{date}_{index}";
    frbr-sru:url "https://zoekservice.overheid.nl/sru/Search?x-connection=cvdr&operation=searchRetrieve&version=2.0&maximumRecords=1&query=dcterms.identifier=CVD{rulesetid}_*%20and%20overheidrg.inwerkingtredingDatum%3C={valid-on}%20sortby%20overheidrg.inwerkingtredingDatum/descending";
    frbr-sru:response-publication-location-term-namespace
        "http://standaarden.overheid.nl/sru";
    frbr-sru:response-publication-location-term
        "publicatieurl_xml";
    frbr-sru:response-from-date-term-namespace
        "http://standaarden.overheid.nl/cvdr/terms/";
    frbr-sru:response-from-date-term
        "inwerkingtredingDatum".
@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.3#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.3/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.3/methods/> .
@prefix core-api: <https://cprmv.open-regels.nl/0.4.3/methods/core-api#> .

cprmvmethods:register-overheids-organisaties a cprmvmethods:module;
    cprmv:id "register-overheids-organisaties"@nl;
    cprmv:label "Register Overheids Organisaties";
    cprmvmethods:hasMethods (
        cprmvmethods:roo
        cprmvmethods:roo-uri
        cprmvmethods:roo-catalogus
    ).

cprmvmethods:roo a cprmv:OrganisationRegister;
    a cprmv-serve:core-api;
    a cprmv-serve:core-json;
    cprmv:id "roo"@en;
    cprmv:id "roo"@nl;
    cprmv:label "Register van OverheidsOrganisaties - Dutch register for public organisations";
    cprmv:comment "see https://organisaties.overheid.nl"@en;
    cprmv-serve:publication-id-format "ROO.{key}={rulesetid}_{date}_{index}";
    cprmv-serve:normalized-id-format "ROO.{key}={rulesetid}_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://api-organisaties.overheid.nl/v1/overheidsorganisaties/identificatie-uitgebreid?{key}={rulesetid}";
    core-api:api-base-url <https://api-organisaties.overheid.nl/v1/>;
    core-api:api-headers (
        ("Accept" "application/json")
    ).

cprmvmethods:roo-uri a cprmv:OrganisationRegister;
    a cprmv-serve:core-api;
    a cprmv-serve:core-json;
    cprmv:id "roo-uri"@en;
    cprmv:id "roo-uri"@nl;
    cprmv:label "Register van OverheidsOrganisaties - Dutch register for public organisations - By URI";
    cprmv:comment "see https://organisaties.overheid.nl"@en;
    cprmv-serve:publication-id-format "ROOURI{uri}_{date}_{index}";
    cprmv-serve:normalized-id-format "ROOURI{uri}_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://api-organisaties.overheid.nl/v1/overheidsorganisaties/{uri}";
    core-api:api-base-url <https://api-organisaties.overheid.nl/v1/>;
    core-api:api-headers (
        ("Accept" "application/json")
    ).

cprmvmethods:roo-catalogus a cprmv:OrganisationRegister;
    a cprmv-serve:core-api;
    a cprmv-serve:core-json;
    cprmv:id "roo-catalogus"@en;
    cprmv:id "roo-catalogus"@nl;
    cprmv:label "Register van OverheidsOrganisaties - Dutch register for public organisations - Whole catalogus";
    cprmv:comment "see https://organisaties.overheid.nl"@en;
    cprmv-serve:publication-id-format "ROO_{date}_{index}";
    cprmv-serve:normalized-id-format "ROO_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://api-organisaties.overheid.nl/v1/overheidsorganisaties";
    core-api:api-base-url <https://api-organisaties.overheid.nl/v1/>;
    core-api:api-headers (
        ("Accept" "application/json")
    ).
