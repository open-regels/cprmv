@base <http://example.com/> .
@prefix cprmv: <https://standaarden.open-regels.nl/standards/cprmv/0.4.1#> .
@prefix cprmv-serve: <https://cprmv.open-regels.nl/0.4.1/serve-api/> .
@prefix cprmvmethods: <https://cprmv.open-regels.nl/0.4.1/methods/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://standaarden.open-regels.nl/standards/cprmv/0.4.1/methods> a owl:Ontology;
  vann:preferredNamespaceURI "https://standaarden.open-regels.nl/standards/cprmv/0.4.1/methods";
  vann:preferredNamespacePrefix "cprmv";
  dct:title "CPRMV";
  dct:description "Core Public Rule Management Vocabulary is a vocabulary for expressing knowledge about agreements published as rules which can both be expressed in natural language like articles in laws as well as more formal business rules for automation of decisions, and also how all these rules relate";
  owl:versionIRI <https://standaarden.open-regels.nl/standards/cprmv/0.4.1/methods>;
  owl:versionInfo "0.4.1";
  dct:created "2026-04-20"^^xsd:date;
  dct:creator <https://www.ictu.nl/>;
  dct:license <https://creativecommons.org/licenses/by/4.0/>;
  rdfs:seeAlso <https://www.open-regels.nl/standards/cprmv/methods> .

cprmvmethods:lawanalysis a cprmv:AnalysisMethod;
    cprmv:id "Law Analysis/JAS"@en;
    cprmv:id "Wetsanalyse/JAS"@nl;
    cprmv:comment "zie: https://regels.overheid.nl/standaarden/wetsanalyse"@nl.

cprmvmethods:calculemusflint a cprmv:AnalysisMethod;
    cprmv:id "Calculemus/FLINT"@en;
    cprmv:id "Calculemus/FLINT"@nl;
    cprmv:comment "zie: https://normativesystems.gitlab.io/knowledge-modeling/documentation-website/docs/"@nl;
    cprmv:comment "see: https://normativesystems.gitlab.io/knowledge-modeling/documentation-website/docs/"@en.

cprmvmethods:bwb a cprmv:AnalysisMethod;
    a cprmv:PublicationMethod;
    cprmv:id "bwb"@nl;
    cprmv:label "BWB (NL)";
    cprmv:comment "zie: https://www.overheid.nl/sites/default/files/wetten/Procedurehandboek_BWB_3.7.pdf and https://www.overheid.nl/sites/default/files/pdf/Handleiding%2BSRU%2BBWB.pdf"@nl;
    cprmv-serve:publication-format "xml";
    cprmv-serve:publication-id-format "BWB{rulesetid}_{date}_{index}";
    cprmv-serve:normalized-id-format "BWB{rulesetid}_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://repository.officiele-overheidspublicaties.nl/bwb/BWB{rulesetid}/{date}_{index}/xml/BWB{rulesetid}_{date}_{index}.xml";
    cprmv-serve:frbr-repository-sru-url "https://zoekservice.overheid.nl/sru/Search?x-connection=BWB&operation=searchRetrieve&version=2.0&maximumRecords=1&query=dcterms.identifier=BWB{rulesetid}%20and%20overheidbwb.geldigheidsdatum={valid-on}";
    cprmv-serve:frbr-repository-sru-response-publication-location-term-namespace
        "http://standaarden.overheid.nl/bwb/terms/";
    cprmv-serve:frbr-repository-sru-response-publication-location-term
        "locatie_toestand";
    cprmv-serve:frbr-repository-sru-response-from-date-term-namespace
        "http://standaarden.overheid.nl/bwb/terms/";
    cprmv-serve:frbr-repository-sru-response-from-date-term
        "geldigheidsperiode_startdatum";
    cprmv-serve:xslt "data/bwb2cprmv.xsl".

cprmvmethods:cvdr a cprmv:AnalysisMethod;
    a cprmv:PublicationMethod;
    cprmv:id "cvdr"@nl;
    cprmv:label "CVDR (NL)";
    cprmv:comment "zie: https://www.overheid.nl/sites/default/files/pdf/Handleiding%2BSRU%2BBWB.pdf"@nl;
    cprmv-serve:publication-format "xml";
    cprmv-serve:publication-id-format "CVD{rulesetid}_{index}";
    cprmv-serve:normalized-id-format "CVD{rulesetid}_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://repository.officiele-overheidspublicaties.nl/cvdr/CVD{rulesetid}/{index}/xml/CVD{rulesetid}_{index}.xml";
    cprmv-serve:frbr-repository-sru-url "https://zoekservice.overheid.nl/sru/Search?x-connection=cvdr&operation=searchRetrieve&version=2.0&maximumRecords=1&query=dcterms.identifier=CVD{rulesetid}_*%20and%20overheidrg.inwerkingtredingDatum%3C={valid-on}%20sortby%20overheidrg.inwerkingtredingDatum/descending";
    cprmv-serve:frbr-repository-sru-response-publication-location-term-namespace
        "http://standaarden.overheid.nl/sru";
    cprmv-serve:frbr-repository-sru-response-publication-location-term
        "publicatieurl_xml";
    cprmv-serve:frbr-repository-sru-response-from-date-term-namespace
        "http://standaarden.overheid.nl/cvdr/terms/";
    cprmv-serve:frbr-repository-sru-response-from-date-term
        "inwerkingtredingDatum";
    cprmv-serve:xslt "data/cvdr2cprmv.xsl".

cprmvmethods:cellarfmx4 a cprmv:AnalysisMethod;
    a cprmv:PublicationMethod;
    cprmv:id "cellarfmx4"@en;
    cprmv:id "cellarfmx4"@nl;
    cprmv:label "CELLAR Formex v4 (EU)";
    cprmv:comment "see: ... "@en;
    cprmv-serve:publication-format "xml";
    cprmv-serve:publication-id-format "CFMX4{rulesetid}_{docid}"; # TODO link this to publication method
    cprmv-serve:normalized-id-format "CFMX4{rulesetid}_{docid}";
    cprmv-serve:repository-publication-location-format "https://publications.europa.eu/resource/cellar/{rulesetid}/{docid}";
    cprmv-serve:frbr-repository-sru-url "https://publications.europa.eu/resource/cellar/{rulesetid}";
    cprmv-serve:xslt "data/fmx4cellar2cprmv.xsl".

cprmvmethods:dmn13 a cprmv:FormalisationMethod;
    a cprmv:PublicationMethod;
    cprmv:id "DMN 1.3"@en;
    cprmv:id "DMN 1.3"@nl;
    cprmv:label "DMN 1.3 on operaton.open-regels.nl (experimental)";
    cprmv:comment "see https://www.omg.org/spec/DMN/1.3/About-DMN";
    cprmv-serve:publication-format "xml";
    cprmv-serve:publication-id-format "DMN1.3_{deploymentid}R{resourceid}_{date}_{index}";
    cprmv-serve:normalized-id-format "DMN1.3_{rulesetid}_{date}_{index}";
    cprmv-serve:repository-publication-location-format "https://operaton.open-regels.nl/engine-rest/deployment/{deploymentid}/resources/{resourceid}/data"; # TODO link this to separate publication / exection method
    cprmv-serve:xslt "data/dmn13operaton2cprmv.xsl".

cprmvmethods:operaton a cprmv:ExecutionMethod;
    a cprmv:PublicationMethod;
    cprmv:id "Operaton"@en;
    cprmv:id "Operaton"@nl;
    cprmv:comment "Operaton allows for being both a method for publication (being used as a RuleRepository) as well as an execution method. See https://www.operaton.org".
    
cprmvmethods:cprmvapi a cprmv:ReferenceMethod;
    cprmv:id "CPRMV API - rule id path"@en;
    cprmv:id "CPRMV API - rule id path"@nl;
    cprmv:comment "CPRMV API functions as a Reference resolver but to enable this harbours it's own way of referencing (rule id path). Also it allows for additional functionality on top of what methods like juriconnect and eli offer";
    cprmv-serve:reference-format "{baseuri}/rules/{path}".
    
cprmvmethods:juriconnect a cprmv:ReferenceMethod;
    cprmv:id "Juriconnect"@en;
    cprmv:id "Juriconnect"@nl;
    cprmv:comment "Juriconnect (not fully supported yet)";
    cprmv-serve:reference-format 'jci1.{subversion}:c:BWB{bwbid}&{locatie-string}';
    cprmv-serve:reference-mapping (
        ( "aanwijzing" "Aanwijzing")
        ( "afdeling" "Afdeling")
        ( "artikel" "Artikel")
        ( "bijlage" "Bijlage")
        ( "boek" "Boek")
        ( "deel" "Deel")
        ( "enig" "enig")
        ( "hoofdstuk" "Hoofdstuk")
        ( "inhoudsopgave" "Inhoudsopgave")
        ( "nummer" "nummer")
        ( "paragraaf" "Paragraaf")
        ( "sub-paragraaf" "Paragraaf")
        ( "titeldeel" "Titeldeel")
        ( "taal" "taal")
        ( "verdragsonderdeel" "Verdragsonderdeel")
        ( "lid" "lid")
        ( "o" "onderdeel")
        ( "volzin" "volzin")
        ( "nummer" "nummer")
        ( cprmv-serve:reference-mapping-valid-on "g")
        ( cprmv-serve:reference-mapping-seen-on "z")
    ).
    
cprmvmethods:elifmx4 a cprmv:ReferenceMethod;
    cprmv:id "ELIFMX4 on EU CELLAR"@en;
    cprmv:id "ELIFMX4 on EU CELLAR"@nl;
    cprmv:comment "ELI references to Formex 4 documents in EU CELLAR";
    cprmv-serve:reference-format "http://data.europa.eu/eli/{typedoc}/{year}/{naturalnumber}/{start-date}".
    
cprmvmethods:elinl a cprmv:ReferenceMethod;
    cprmv:id "ELI for BWB and CVDR"@en;
    cprmv:id "ELI for BWB and CVDR"@nl;
    cprmv:comment "Experimental ELI for NL";
    cprmv-serve:reference-format "https://wetten.overheid.nl/{path}".

cprmv:acknowledged a owl:ObjectProperty;
    skos:prefLabel "id"@en;
    skos:definition "denotes that a given RuleMethod is ackknowledged to be a member of a certain RuleMethod set."@en.

cprmvmethods:rulemethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:lawanalysis
        cprmvmethods:calculemusflint
        cprmvmethods:bwb
        cprmvmethods:cvdr
        cprmvmethods:cellarfmx4
        cprmvmethods:dmn13
    ).

cprmvmethods:analysismethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:lawanalysis
        cprmvmethods:calculemusflint
        cprmvmethods:bwb
        cprmvmethods:cvdr
        cprmvmethods:cellarfmx4
    ).

cprmvmethods:formalisationmethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:dmn13
    ).

cprmvmethods:codificationmethods a owl:Class;
    cprmv:acknowledged ().

cprmvmethods:testmethods a owl:Class;
    cprmv:acknowledged ().

cprmvmethods:executionmethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:operaton
    ).

cprmvmethods:publicationmethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:bwb
        cprmvmethods:cvdr
        cprmvmethods:cellarfmx4
        cprmvmethods:operaton
    ).

cprmvmethods:referencemethods a owl:Class;
    cprmv:acknowledged (
        cprmvmethods:cprmvapi
        cprmvmethods:juriconnect
        cprmvmethods:elifmx4
        cprmvmethods:elinl
    ).


